# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env or real API keys to Git!

SERVER_PORT=8080
KALASETU_MODE=supabase

# Supabase Project Configuration (Found in Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=product-images

# Test Payment Mode Guard (Must stay true in academic/demo environments)
KALASETU_PAYMENT_TEST_MODE=true

# File I/O Output Directory
KALASETU_DATA_DIR=./runtime-data
